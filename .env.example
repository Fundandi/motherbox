# Kopiér til .env og udfyld. .env må ALDRIG committes.
DEBUG=True
SECRET_KEY=skift-mig-til-en-lang-tilfaeldig-streng
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000
# DATABASE_URL=postgres://user:pass@host:5432/db   (tom = SQLite lokalt)

# Pris
SUBSCRIPTION_MONTHLY_PRICE=349

# Stripe (Dashboard → Developers → API keys). Start med test-nøgler.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Dashboard → Developers → Webhooks → endpoint https://DITDOMÆNE/stripe/webhook/
STRIPE_WEBHOOK_SECRET=
# Dashboard → Settings → Billing → Customer portal → "Login link"
STRIPE_CUSTOMER_PORTAL_URL=
# Valgfrit, fx: card,mobilepay  (tom = brug metoderne slået til i Dashboard)
STRIPE_PAYMENT_METHOD_TYPES=

# Virksomhed (vises i footer/handelsbetingelser)
COMPANY_LEGAL_NAME=MB ApS
COMPANY_CVR=39816792
COMPANY_ADDRESS=
COMPANY_EMAIL=info@motherbox.dk
COMPANY_PHONE=


# E-mail (fx via Postmark/Mailgun/Gmail SMTP). Tom = mails skrives i konsollen.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@motherbox.dk

# Efter registrering hos Fødevarestyrelsen: link til jeres side på findsmiley.dk
SMILEY_URL=
